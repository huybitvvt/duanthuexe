APP_NAME=HIMOTO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
BASE_URL=http://localhost
FRONTEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080
CORS_SUPPORTS_CREDENTIALS=false

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_SCHEMA=himoto
DB_PERSISTENT=false
# Production can use Supabase's Session pooler URI instead of the DB_* values.
DATABASE_URL=
# Local PowerShell helper reads this from the ignored .env.supabase file.
SUPABASE_DATABASE_URL=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
DASHBOARD_CACHE_SECONDS=30
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

URL_API_WALLET=http://localhost:8000
VUE_APP_API_URL=http://smart-investment-api.test/api
JWT_SECRET=
PERCENT=5
JWT_TTL=10000

# Compiled into the static frontend. This value is public and must not contain secrets.
# Leave blank for same-origin API calls. Localhost bundles also follow the
# browser port automatically (for example http://127.0.0.1:8091).
MIX_API_URL=

# Cloudinary credentials are backend-only. Never use CLOUDINARY_API_SECRET in Vue code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=himoto/vehicles

# Server-side credentials for the optional WordPress lead sync command.
WORDPRESS_LEADS_URL=https://himoto.vn/wp-json/omg-leads/v1/leads?limit=-1
WORDPRESS_LEADS_TOKEN=

# Run outstanding Laravel migrations when the Render container starts.
RUN_MIGRATIONS=false

# Safety gates. Keep disabled until policy/provider approval and staging UAT.
HIMOTO_ENABLE_OWNERSHIP_EXECUTE=false
REMINDER_LIVE_ENABLED=false
REMINDER_PROVIDER=sandbox
REMINDER_WEBHOOK_SECRET=
REMINDER_WHITELIST_PHONES=
GPS_PROVIDER=sandbox
