APP_NAME=HIMOTO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
BASE_URL=http://localhost
FRONTEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080
CORS_SUPPORTS_CREDENTIALS=false

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SCHEMA=public
# Production can use Supabase's Session pooler URI instead of the DB_* values.
DATABASE_URL=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

URL_API_WALLET=http://localhost:8000
VUE_APP_API_URL=http://smart-investment-api.test/api
JWT_SECRET=
PERCENT=5
JWT_TTL=10000

# Compiled into the static frontend. This value is public and must not contain secrets.
MIX_API_URL=http://localhost:8000

# Cloudinary credentials are backend-only. Never use CLOUDINARY_API_SECRET in Vue code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=himoto/vehicles

# Server-side credentials for the optional WordPress lead sync command.
WORDPRESS_LEADS_URL=https://himoto.vn/wp-json/omg-leads/v1/leads?limit=-1
WORDPRESS_LEADS_TOKEN=

# Run outstanding Laravel migrations when the Render container starts.
RUN_MIGRATIONS=false
